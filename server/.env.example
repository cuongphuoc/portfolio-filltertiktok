# MongoDB connection string. NOTE: root user lives in the `admin` db,
# so when a database name is present you MUST add `?authSource=admin`.
MONGODB_URI=mongodb://mongo:<password>@<host>:27017/portfolio?authSource=admin

# Long random string used to sign JWT tokens
JWT_SECRET=change-me-to-a-long-random-string

# Port the server listens on
PORT=3000

# Admin credentials used by the seed script to create the initial admin user
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Cloudflare R2 (S3-compatible) — for blog image uploads
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<access-key-id>
R2_SECRET_ACCESS_KEY=<secret-access-key>
R2_BUCKET=portfolio
R2_PUBLIC_URL=https://pub-<hex>.r2.dev
